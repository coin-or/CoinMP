@COIN_RELOCATABLE_FALSE@prefix=@prefix@
@COIN_RELOCATABLE_TRUE@prefix=${pcfiledir}/../..
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@/coin-or

Name: CoinMP
Description: Simple C API for COIN-OR Solvers Clp and Cbc
URL: @PACKAGE_URL@
Version: @PACKAGE_VERSION@
Cflags: -I${includedir}
@COIN_STATIC_BUILD_FALSE@Libs: -L${libdir} -lCoinMP
@COIN_STATIC_BUILD_FALSE@Requires.private: @COINMPLIB_PCFILES@
@COIN_STATIC_BUILD_TRUE@Libs: -L${libdir} -lCoinMP @COINMPLIB_LFLAGS_NOPC@
@COIN_STATIC_BUILD_TRUE@Requires: @COINMPLIB_PCFILES@
